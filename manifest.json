{
  "manifest_version": 3,
  "name": "AI Learning Agent",
  "version": "1.0",
  "description": "Analyze lectures and generate notes",
  "permissions": [
  "activeTab",
  "scripting",
  "tabs",
  "tabCapture",
  "storage",
  "offscreen"
],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}